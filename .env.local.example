# Supabase (Ajustes > API del proyecto)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo servidor. Necesaria para el cron de avisos (lee a todos los empleados).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Web Push. Genera el par con: bun run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:avisos@tuempresa.com

# Protege /api/cron/avisos (Vercel Cron manda este valor en Authorization: Bearer)
CRON_SECRET=cambia-esto

# Calendario de Google (solo lectura). Cuenta de servicio compartida con el
# calendario con permiso de "Ver todos los detalles del evento" — nada más.
GOOGLE_CALENDAR_ID=xxxx@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxx@tu-proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
