# Supabase (Ajustes > API del proyecto)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo servidor. Necesaria para el cron de avisos (lee a todos los empleados).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Web Push. Genera el par con: bun run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:avisos@tuempresa.com

# Protege /api/cron/avisos (Vercel Cron manda este valor en Authorization: Bearer)
CRON_SECRET=cambia-esto
